ELEVENLABS_API_KEY=
# Get a free key from https://aistudio.google.com/apikey — same key works for
# both Gemma and Gemini models (they share the generativelanguage.googleapis.com
# endpoint).
GEMINI_API_KEY=
# Default if unset: gemma-4-26b-a4b-it. Other valid values:
#   gemma-4-31b-it          (larger Gemma 4)
#   gemini-2.5-flash        (Gemini fallback, supports forced-JSON output)
GEMINI_MODEL=

# ─── MongoDB for the vibing/learning metrics gauge ───────────────────────
# Required for the bottom-right status bar (Vibing % / Learning %).
# Free cluster: https://www.mongodb.com/cloud/atlas/register
#   1. Create M0 (free) cluster
#   2. Database Access → Add user with password auth
#   3. Network Access → Allow 0.0.0.0/0 (demo only)
#   4. Click Connect → Drivers → Python 3.12+ → copy the SRV string
#   5. Replace <password> and paste below.
# Verify it worked: `curl http://localhost:8000/metrics/health` should
# return {"ok": true, "detail": "connected (N events in collection)"}.
MONGODB_URI=
MONGODB_DB=vibecheck