{
  "name": "vibecheck",
  "displayName": "VibeCheck",
  "description": "Comprehension checkpoints for AI-generated code (Windsurf + Devin).",
  "version": "0.0.1",
  "publisher": "vibecheck",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibecheck.showGrowth",
        "title": "VibeCheck: Show Growth Dashboard"
      },
      {
        "command": "vibecheck.openCheckpoint",
        "title": "VibeCheck: Open Checkpoint"
      },
      {
        "command": "vibecheck.simulateAIBurst",
        "title": "VibeCheck: Simulate AI Burst (test detection)"
      },
      {
        "command": "vibecheck.submitAnswer",
        "title": "Submit answer",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "vibecheck.overrideThread",
        "title": "Override"
      },
      {
        "command": "vibecheck.skipThread",
        "title": "Skip"
      },
      {
        "command": "vibecheck.dismissThread",
        "title": "Dismiss"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "vibecheck.submitAnswer",
          "group": "inline@1",
          "when": "commentController == vibecheck && commentThread == vibecheck-unresolved"
        },
        {
          "command": "vibecheck.skipThread",
          "group": "inline@2",
          "when": "commentController == vibecheck && commentThread == vibecheck-unresolved"
        },
        {
          "command": "vibecheck.overrideThread",
          "group": "inline@3",
          "when": "commentController == vibecheck && commentThread == vibecheck-unresolved"
        },
        {
          "command": "vibecheck.dismissThread",
          "group": "inline@1",
          "when": "commentController == vibecheck && commentThread == vibecheck-resolved"
        }
      ],
      "commandPalette": [
        {
          "command": "vibecheck.submitAnswer",
          "when": "false"
        },
        {
          "command": "vibecheck.overrideThread",
          "when": "false"
        },
        {
          "command": "vibecheck.skipThread",
          "when": "false"
        },
        {
          "command": "vibecheck.dismissThread",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibecheck",
          "title": "VibeCheck",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "vibecheck": [
        {
          "id": "vibecheck.growth",
          "name": "Growth",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "VibeCheck",
      "properties": {
        "vibecheck.checkpointUi": {
          "type": "string",
          "enum": ["comments", "native", "webview"],
          "default": "comments",
          "enumDescriptions": [
            "Inline GitHub-PR-style comment threads anchored to the AI region (recommended).",
            "Sequence of VSCode info dialogs + InputBox. Bulletproof but ugly.",
            "Rich HTML webview panel. Prettiest but flaky on some VSCode Remote setups."
          ],
          "description": "How comprehension checkpoints are presented when an AI burst is detected."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ohm-Rajpal/VibeCheck"
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "build:webview": "cd webview && npm run build",
    "package": "vsce package --no-dependencies",
    "update:extension": "bash ../../scripts/update-editor-extension.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
